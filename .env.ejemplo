# ─────────────────────────────────────────────────────────────────────────
#  Variables de entorno — despliegue en Vercel
#
#  En Vercel NO se sube ningun archivo .env: estas mismas claves se cargan
#  en Settings → Environment Variables del proyecto. Este archivo sirve
#  como referencia y para correr la API en local con un .env propio.
# ─────────────────────────────────────────────────────────────────────────

# ── Base de datos (Neon) ──
# Al conectar Neon desde el Marketplace de Vercel se crean solas varias
# variables (DATABASE_URL, POSTGRES_URL...). El codigo lee BD_URL, asi que
# hay que copiar el valor de DATABASE_URL aqui.
#
# Debe terminar en ?sslmode=require: Neon solo acepta conexiones cifradas.
BD_URL=postgresql://usuario:clave@ep-algo.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Almacenamiento de imagenes (Vercel Blob) ──
# La inyecta Vercel automaticamente al conectar un store de Blob al
# proyecto. Solo hay que copiarla si se quiere subir imagenes desde local.
BLOB_READ_WRITE_TOKEN=

# ── Seguridad / JWT ──
# Genera uno con:  openssl rand -base64 48
JWT_SECRETO=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_DURACION=8h

# ── Usuario administrador inicial (lo crea "npm run sembrar") ──
ADMIN_CORREO=admin@arigatours.com
ADMIN_CLAVE=CambiaEstaClaveDeAdministrador

# ── CORS ──
# Vacio en Vercel: la web y la API comparten dominio. Solo hace falta en
# local, donde Vite corre en otro puerto.
ORIGENES_PERMITIDOS=

# ── Correo del formulario de contacto ──
# Si SMTP_USUARIO queda vacio, las consultas se guardan en la base de datos
# pero no se envia aviso por correo. La web sigue funcionando igual.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_DESTINO=arigatoursceo@gmail.com

# ── Solo para correr la API en local ──
PUERTO=4020
NODE_ENV=desarrollo
